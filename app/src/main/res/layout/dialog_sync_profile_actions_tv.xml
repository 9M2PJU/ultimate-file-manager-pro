<?xml version="1.0" encoding="utf-8"?>
<!--
    Sync Profile Actions Dialog — TV Standard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="460dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Hero Frosted Icon Badge -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_icon_frosted"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sync"
            app:tint="@color/tv_accent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textAlignment="center"
        android:layout_marginBottom="4dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="20dp" />

    <!-- Primary Action: Sync Now (Yellow Accent) -->
    <Button
        android:id="@+id/btnSyncNow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/sync_now"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/tv_text_primary"
        android:background="@drawable/selector_tv_button_yellow"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <!-- Secondary Action: Edit -->
    <Button
        android:id="@+id/btnEdit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/edit"
        android:textSize="14sp"
        android:textColor="@color/tv_text_primary"
        android:background="@drawable/selector_tv_button"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <!-- Toggle Action -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/sync_action_disable"
        android:textSize="14sp"
        android:textColor="@color/tv_text_primary"
        android:background="@drawable/selector_tv_button"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <!-- Delete Action -->
    <Button
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/action_delete"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:background="@drawable/selector_tv_button_danger"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <!-- Cancel Action -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/cancel"
        android:textSize="13.5sp"
        android:textColor="@color/tv_text_secondary"
        android:background="@drawable/selector_tv_button"
        android:focusable="true" />

</LinearLayout>
