<?xml version="1.0" encoding="utf-8"?>
<!--
    Mobile Transfer / Extraction / Compression Progress Dialog - UFM Glass Standard
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Title row with frosted hero icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imgProgressIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_copy"
                app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtProgressTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/copying_files"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtProgressFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/item_00"
        android:textColor="@color/mobile_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtProgressCurrentFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/filenameext"
        android:textColor="@color/mobile_text_primary"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="middle" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:trackThickness="8dp"
        app:trackCornerRadius="4dp"
        android:progress="0"
        app:indicatorColor="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/txtProgressSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/s_0_mb_0_mb_0"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtProgressSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Multi-Threading & Per-Thread Speed Section (UFMStandard) -->
    <LinearLayout
        android:id="@+id/layoutThreadSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_reindex_option_card"
        android:padding="12dp">

        <!-- Thread Header: Icon + Title + Per-thread speed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_lightning"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/txtThreadSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transfer_threads_header"
                android:textColor="@color/mobile_text_primary"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/txtPerThreadSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transfer_per_thread_placeholder"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Grid / Container for Individual Threads -->
        <GridLayout
            android:id="@+id/gridThreadSpeeds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true" />
    </LinearLayout>

    <!-- Embedded Cancel Button (UFMStandard) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3Expressive.Button"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:text="@string/cancel"
        android:textColor="@color/mobile_text_primary"
        app:backgroundTint="@color/mobile_glass_card"
        app:strokeColor="@color/mobile_glass_stroke"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp" />

</LinearLayout>
