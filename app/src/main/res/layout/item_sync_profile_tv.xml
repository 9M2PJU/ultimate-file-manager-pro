<?xml version="1.0" encoding="utf-8"?>
<!--
    Folder Sync TV Row Item (TV Standard - Compact ~84dp)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/tv_glass_white_10"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/tv_glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- 44dp Frosted Sync Icon Container -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_icon_frosted">

            <ImageView
                android:id="@+id/iconSync"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sync"
                app:tint="@color/tv_accent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Main Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp">

            <!-- Title & Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Camera Upload Sync" />

                <TextView
                    android:id="@+id/txtInterval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_status_badge_accent"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/tv_accent"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Every 1h" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/tv_accent"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-bold"
                    tools:text="Active" />
            </LinearLayout>

            <!-- Route Row: Source ➔ Dest -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/txtSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:drawablePadding="6dp"
                    app:drawableStartCompat="@drawable/ic_phone"
                    app:drawableTint="@color/tv_text_secondary"
                    tools:text="DCIM/Camera" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:rotation="180"
                    android:alpha="0.6"
                    app:tint="@color/tv_text_secondary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/txtDest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:drawablePadding="6dp"
                    app:drawableStartCompat="@drawable/ic_network"
                    app:drawableTint="@color/tv_text_secondary"
                    tools:text="NAS Media / Backups" />
            </LinearLayout>

        </LinearLayout>

        <!-- Right Column: Last Sync + Chevron -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtLastSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_hint"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="12dp"
                tools:text="Last sync: 2 hours ago" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                android:alpha="0.5"
                app:tint="@color/tv_text_secondary"
                android:importantForAccessibility="no" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
